{
  "name": "paradise-gym-backend",
  "version": "1.0.0",
  "description": "Paradise Gym - Core Backend REST API & Database Service",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/initDb.js",
    "db:seed": "node src/db/seed.js",
    "test": "node tests/web-rebuild.integration.js",
    "test:legacy": "node tests/verify_all.js",
    "db:migrate": "node src/db/migrate.js",
    "db:repair-seed-passwords": "node src/db/seed.js --repair-placeholder-passwords"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.7.5",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0"
  }
}
